#: includes/admin/tab-about.php:18
msgid "Advanced plugin for automatic, human-like WordPress post scheduling."
msgstr ""
"Extension avancée pour la planification automatique et humaine des articles "
"WordPress."

#: includes/admin/tab-about.php:19
msgid ""
"Designed to optimize your SEO publishing flow while keeping a natural "
"appearance."
msgstr ""
"Conçue pour optimiser votre flux de publication SEO tout en gardant une "
"apparence naturelle."

#: includes/admin/tab-about.php:22
msgid "What's New in v2.6"
msgstr "Nouveautés de la v2.6"

#: includes/admin/tab-about.php:24
msgid "Flexible cadence"
msgstr "Cadence flexible"

#: includes/admin/tab-about.php:24
msgid ""
"schedule by day, week, or month (e.g. \"2/week\", \"6/month\"), not just "
"posts/day"
msgstr ""
"planifiez par jour, semaine ou mois (ex. « 2/semaine », « 6/mois »), pas "
"seulement articles/jour"

#: includes/admin/tab-about.php:25 scheduler-pro.php:173
msgid "Category exclusion"
msgstr "Exclusion de catégories"

#: includes/admin/tab-about.php:25
msgid "keep entire categories out of auto-scheduling"
msgstr "exclure des catégories entières de la planification automatique"

#: includes/admin/tab-about.php:26 scheduler-pro.php:174
msgid "Preview before running"
msgstr "Aperçu avant exécution"

#: includes/admin/tab-about.php:26
msgid "see the exact resulting dates before committing anything"
msgstr "voyez les dates exactes résultantes avant de valider quoi que ce soit"

#: includes/admin/tab-about.php:27 scheduler-pro.php:175
msgid "Email alerts"
msgstr "Alertes email"

#: includes/admin/tab-about.php:27
msgid "get notified if the scheduler stops running"
msgstr "être notifié si le planificateur s'arrête"

#: includes/admin/tab-about.php:28 scheduler-pro.php:176
msgid "Calendar view"
msgstr "Vue calendrier"

#: includes/admin/tab-about.php:28
msgid "2-month day-by-day view of the upcoming schedule"
msgstr "Vue jour par jour sur 2 mois du planning à venir"

#: includes/admin/tab-about.php:31
msgid "Core Features"
msgstr "Fonctionnalités principales"

#: includes/admin/tab-about.php:33
msgid "Batch processing"
msgstr "Traitement par lots"

#: includes/admin/tab-about.php:33
msgid "handles thousands of posts without timing out"
msgstr "gère des milliers d’articles sans timeout"

#: includes/admin/tab-about.php:34
msgid "Memory management"
msgstr "Gestion de la mémoire"

#: includes/admin/tab-about.php:34
msgid "stops automatically if RAM usage gets too high"
msgstr ""
"s'arrête automatiquement si l'utilisation de la RAM devient trop élevée"

#: includes/admin/tab-about.php:35
msgid "Locking system"
msgstr "Système de verrouillage"

#: includes/admin/tab-about.php:35
msgid "prevents duplicate runs"
msgstr "empêche les exécutions en double"

#: includes/admin/tab-about.php:36
msgid "Ultra-human generator"
msgstr "Générateur ultra-humain"

#: includes/admin/tab-about.php:36
msgid "activity peaks at 9am, 2pm, 5pm"
msgstr "pics d’activité à 9h, 14h, 17h"

#: includes/admin/tab-about.php:37
msgid "Real-time monitoring"
msgstr "Monitoring en temps réel"

#: includes/admin/tab-about.php:37
msgid "watches system health"
msgstr "surveille la santé du système"

#: includes/admin/tab-about.php:38
msgid "Task queue"
msgstr "File de tâches"

#: includes/admin/tab-about.php:38
msgid "full traceability of every scheduling run"
msgstr "traçabilité complète de chaque exécution de planification"

#: includes/admin/tab-about.php:41
msgid "Recommended Configuration"
msgstr "Configuration Recommandée"

#: includes/admin/tab-about.php:44
msgid "Cadence:"
msgstr "Cadence :"

#: includes/admin/tab-about.php:45
msgid ""
"3-5/day (natural and SEO-friendly), or a week/month cadence for a lighter "
"rhythm"
msgstr ""
"3-5/jour (naturel et adapté au SEO), ou une cadence semaine/mois pour un "
"rythme plus léger"

#: includes/admin/tab-about.php:48
msgid "Time range:"
msgstr "Plage horaire :"

#: includes/admin/tab-about.php:49
msgid "7am-8pm (human activity hours)"
msgstr "7h-20h (heures d'activité humaine)"

#: includes/admin/tab-about.php:52
msgid "Auto mode:"
msgstr "Mode automatique :"

#: includes/admin/tab-about.php:53
msgid "Enabled (runs daily at 00:30, site time)"
msgstr "Activé (s'exécute chaque jour à 00h30, heure du site)"

#: includes/admin/tab-about.php:56
msgid "Server cron:"
msgstr "Cron serveur :"

#: includes/admin/tab-about.php:57
msgid "Recommended for maximum reliability"
msgstr "Recommandé pour une fiabilité maximale"

